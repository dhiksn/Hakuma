# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Target website ───────────────────────────────────────────────────────────
BASE_URL=https://hanime.tv

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Use * for dev, set specific origin(s) for production.
# Example production: CORS_ORIGIN=https://hakumaa.vercel.app
CORS_ORIGIN=http://localhost:3001

# ── HTTP client ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15000
MAX_RETRIES=3

# ── Player / HLS handshake ───────────────────────────────────────────────────
# HTV_HANDSHAKE_URL: URL of your Cloudflare Worker relay (required for video playback).
# Deploy the worker from /worker to Cloudflare Workers, then set the URL here.
# Example: HTV_HANDSHAKE_URL=https://hanime.dhiksn.my.id/api/v11/handshake
HTV_HANDSHAKE_URL=

# HTV_RELAY_SECRET: Bearer secret shared between this backend and the CF Worker.
# REQUIRED for video playback — set via `wrangler secret put RELAY_SECRET` on the worker,
# then put the same value here.
HTV_RELAY_SECRET=

# SCRAPE_PROXY_URL: Route all hanime.tv scraping through CF Worker to bypass IP blocks.
# Set this when deploying to Vercel (AWS IPs get 403 from hanime.tv).
# Example: SCRAPE_PROXY_URL=https://hanime.dhiksn.my.id/api/scrape
SCRAPE_PROXY_URL=
