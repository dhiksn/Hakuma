# Server
PORT=3000
NODE_ENV=development

# Target website base URL
BASE_URL=https://hanime.tv

# CORS — set ke origin spesifik di production, e.g. https://hakuma.yourdomain.com
# Jangan gunakan * di production!
CORS_ORIGIN=http://localhost:3001

# Request timeout in milliseconds
REQUEST_TIMEOUT=15000

# Max retries on failed request
MAX_RETRIES=3

# Player / HLS stream (optional — set jika direct ke auth.hanime.tv di-block dari server)
# Deploy worker dari hanime-stremio/workers/handshake-relay ke Cloudflare Workers
# lalu set URL worker dan secret di bawah ini
HTV_HANDSHAKE_URL=https://auth.hanime.tv/api/v11/handshake
HTV_RELAY_SECRET=
